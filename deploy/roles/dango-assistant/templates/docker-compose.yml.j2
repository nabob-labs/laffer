services:
  velox-assistant:
    image: {{ velox_assistant_image }}:{{ velox_assistant_tag }}
    pull_policy: always
    container_name: {{ velox_assistant_container_name }}
    restart: unless-stopped
    environment:
      - DISCORD__TOKEN={{ velox_assistant_discord_token }}
      - CLAUDE_CODE_OAUTH_TOKEN={{ velox_assistant_claude_oauth_token }}
    volumes:
      - claude-creds:/root/.claude
      - ./config.json:/root/.assist-velox-bot/config.json
      - ./db:/root/.assist-velox-bot/db

volumes:
  claude-creds:
