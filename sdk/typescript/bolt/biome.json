{
  "root": false,
  "$schema": "https://biomejs.dev/schemas/2.1.3/schema.json",
  "extends": ["@laffer/config/biome/common.json"],
  "linter": {
    "rules": {
      "correctness": {
        "noUnusedVariables": {
          "level": "warn",
          "options": {
            "ignoreRestSiblings": true
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/chains/definitions/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noTemplateCurlyInString": "off"
          }
        }
      }
    }
  ]
}
